# =====================================================================
# CB Media Hub — Environment Variables Template
# Copy this file to `.env` (local) or set in Railway → Variables tab.
# NEVER commit `.env` with real secrets.
# =====================================================================

# -------- Runtime --------
# Railway sẽ tự inject PORT, không cần set thủ công.
PORT=3000
NODE_ENV=production

# Public URL của app (dùng cho share link, password reset email, OAuth callback).
PUBLIC_APP_URL=https://your-app.up.railway.app

# -------- Error tracking (Sentry) --------
# Lấy DSN tại sentry.io → Projects → CB Media Hub → Settings → Client Keys (DSN).
# DSN là public-safe (Sentry design như vậy). Để trống = disable Sentry.
# Frontend pick up qua window.MH_CONFIG.SENTRY_DSN trong assets/config.js.
SENTRY_DSN=
SENTRY_ENV=production
SENTRY_RELEASE=cb-creative-flow@1.0.0

# =====================================================================
# Phase 1 — Database & Auth (CHƯA dùng, scaffold cho lần triển khai sau)
# =====================================================================

# -------- PostgreSQL trên Railway --------
# Khi add Postgres add-on, Railway tự inject DATABASE_URL. Không cần set thủ công.
# Format: postgresql://user:password@host:port/db
DATABASE_URL=

# -------- Supabase (option) --------
# Nếu dùng Supabase thay vì tự host PG.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -------- JWT / Session --------
# Generate bằng: openssl rand -base64 32
JWT_SECRET=
SESSION_SECRET=
JWT_EXPIRES_IN=7d

# =====================================================================
# Phase 2 — File storage & AI proxy (CHƯA dùng)
# =====================================================================

# -------- File Storage --------
# Phase 2 dùng Supabase Storage (cùng SUPABASE_URL + SUPABASE_ANON_KEY ở trên).
# Buckets: avatars (public, 2MB), brief-files (private, 50MB), deliverables (private, 500MB).
# Setup: chạy supabase/storage.sql.

# (Backup option — Cloudflare R2 nếu muốn tách storage khỏi Supabase)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=cb-media-hub-uploads
# R2_PUBLIC_URL=https://pub-xxx.r2.dev

# -------- AI providers (backend proxy) --------
# KHÔNG expose vào client JS. Backend Node proxy mới được dùng.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SUPERTONIC_MODEL_PATH=/app/models/supertonic-3

# -------- Email (Resend / SMTP) --------
RESEND_API_KEY=
EMAIL_FROM=noreply@cbcentres.com
EMAIL_REPLY_TO=hello@cbcentres.com
